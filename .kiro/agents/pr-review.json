{
  "name": "pr-review",
  "description": "Read-only governed PR reviewer using exact Registry skill resources.",
  "tools": ["read", "grep", "disclose_context"],
  "allowedTools": ["read", "grep", "disclose_context"],
  "resources": [
    "file://.kiro/skills/secure-pr-review/SKILL.md",
    "file://.kiro/skills/test-impact-analysis/SKILL.md",
    "file://.kiro/skills/review-evidence-summary/SKILL.md",
    "file://review-contract.json"
  ],
  "permissions": {
    "rules": [
      {"capability": "fs_read", "match": ["/workspace/**"], "effect": "allow"},
      {"capability": "fs_write", "match": ["*"], "effect": "deny"},
      {"capability": "shell", "match": ["*"], "effect": "deny"},
      {"capability": "web_fetch", "match": ["*"], "effect": "deny"},
      {"capability": "web_search", "match": ["*"], "effect": "deny"},
      {"capability": "mcp", "match": ["*"], "effect": "deny"},
      {"capability": "subagent", "match": ["*"], "effect": "deny"}
    ]
  },
  "prompt": "Review only the supplied patch and repository files. Apply every loaded Registry skill resource directly; do not delegate to sub-agents. Never modify or execute code, and return only the required JSON evidence object with exact skill fingerprints."
}
